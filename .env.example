# The hosted Chowseek project supplies the Supabase admin client to Edge Functions
# through the same @supabase/server wrapper used by the existing Chowseek functions.
# It also already has STRIPE_API_KEY. Only restaurant-specific values are needed.
STRIPE_RESTAURANT_STARTER_PRICE_ID=price_...
STRIPE_RESTAURANT_GROWTH_PRICE_ID=price_...
RESTAURANT_STRIPE_WEBHOOK_SECRET=whsec_...
PORTAL_URL=https://sponsor.chowseek.com/
