# The hosted Chowseek project supplies Supabase admin context to Edge Functions.
# Restaurant sponsorship billing intentionally uses a separate LIVE restricted Stripe key
# so the existing consumer STRIPE_API_KEY can remain unchanged.
RESTAURANT_STRIPE_API_KEY=rk_live_...
PORTAL_URL=https://sponsor.chowseek.com/

# The restaurant Stripe webhook signing secret and cron secret are stored in Supabase Vault,
# not in this file or browser code.
